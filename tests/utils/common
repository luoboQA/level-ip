#!/bin/bash

set -eu

repo="$(git rev-parse --show-toplevel)"
folder="$(dirname $0)"

function start_stack {
    "$repo/lvl-ip" > ../lvl-ip-test.log 2>&1 &
    stackip="$!"

    for i in {1..10}; do
        if ! kill -0 "$stackip" 2>/dev/null; then
            break
        fi

        ping -c1 -W1 10.0.0.5 >/dev/null 2>&1 && return 0

        sleep 1
    done

    echo "Stack did not start up correctly" >&2
    cat ../lvl-ip-test.log
    kill "$stackip" 2>/dev/null || true
    wait "$stackip" 2>/dev/null || true
    return 1
}

function test_pass {
    echo -e "\t$2 Test pass: $1"
}

function test_fail {
    echo -e "\t$2 Test fail: $1" 2>&1
    exit 1
}

function test_run {
    eval "$1" || test_fail "$1" "$2"

    test_pass "$1" "$2"
}
