#!/bin/bash

set -eu

source "utils/common"

function teardown {
    for i in ${pids:-}; do
        kill "$i" 2>/dev/null || true
    done

    if [ -n "${stackip:-}" ]; then
        kill "$stackip" 2>/dev/null || true
        wait "$stackip" 2>/dev/null || true
    fi

    # Remove the root qdisc so a subsequent test run starts cleanly.
    tc qdisc del dev tap0 root 2>/dev/null || true
}

trap teardown EXIT ERR

if ! start_stack; then
  exit 1
fi
echo "Started lvl-ip with pid $stackip"
sleep 5 # wait for stack to establish itself

pids=""

tc qdisc replace dev tap0 root handle 1: htb

./suites/arp/suite-arp &
pids="$pids $!"
./suites/icmp/suite-icmp &
pids="$pids $!"
./suites/tcp/suite-curl &
pids="$pids $!"
./suites/tcp/suite-packet-delay &
pids="$pids $!"
./suites/tcp/suite-packet-duplication &
pids="$pids $!"
./suites/tcp/suite-packet-loss &
pids="$pids $!"

rc=0
for i in $pids; do
  if wait "$i"; then
    pid_rc=0
  else
    pid_rc="$?"
  fi
  [ "$pid_rc" -ne 0 ] && rc="$pid_rc"
done

grep -i -B50 "SUMMARY: ThreadSanitizer:" ../lvl-ip-test.log && echo "Possible threading errors found."

echo
[ "$rc" -eq 0 ] && echo "Tests pass."
exit "$rc"
