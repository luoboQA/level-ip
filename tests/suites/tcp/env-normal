#!/bin/bash

set -eu

source "$(dirname $0)/../../utils/common"
# Simple end-to-end test for an application's curl

function strip_http_header {
    sed 's/\r$//' | sed 's/^Date:.*/Date:/' | sed 's/^Server:.*/Server:/'
}

function setup {
    local oldpwd="$PWD"
    cd "$(dirname "$0")"
    /usr/bin/env python3 -m http.server 8001 >/dev/null 2>&1 &
    httpserver="$!"
    cd "$oldpwd"
    sleep 5
}

function teardown_suite {
    kill "$httpserver" 2>/dev/null || true
}

trap teardown_suite EXIT ERR
setup
